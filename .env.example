# Supabase credentials (Get these from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Anti-Spam CAPTCHA (Cloudflare Turnstile is preferred)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Alternative: Google reCAPTCHA v3 (if used instead of Cloudflare Turnstile)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Contact Page Email Delivery Configuration
CONTACT_TO_EMAIL=work@gmail.com
CONTACT_FROM_EMAIL=Grove PMS <notifications@vineetvardhan.dev>

# Transactional Email Providers (Choose one or leave unset for console/dev mode)
# Resend (Recommended for Next.js App Router)
RESEND_API_KEY=re_your_resend_api_key_here

# SendGrid (Alternative)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Postmark (Alternative)
# POSTMARK_SERVER_TOKEN=your-postmark-server-token-here

# Webhook (Optional CRM / Slack / Zapier webhook notification)
# CONTACT_WEBHOOK_URL=https://your-webhook-endpoint.com/contact-inquiries
